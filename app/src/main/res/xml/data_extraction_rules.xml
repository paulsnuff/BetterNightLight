<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Android 12 (API 31) and newer.
   Controls cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include user settings DataStore -->
        <include
            domain="file"
            path="datastore" />
        <include
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Include user settings DataStore during device-to-device migration -->
        <include
            domain="file"
            path="datastore" />
        <include
            domain="sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
